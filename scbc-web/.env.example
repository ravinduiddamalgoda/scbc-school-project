# Copy to .env.local and adjust as needed.

# Where the API lives.
#
# Leave unset in development: vite.config.js proxies /api to
# http://localhost:8080, which keeps the browser on one origin so the session
# and CSRF cookies are first-party.
#
# For a split-domain production build, point this at the API host and add that
# origin to scbc.cors.allowed-origins on the server.
# VITE_API_BASE_URL=https://api.scbc.example.org/api
